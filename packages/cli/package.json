{
  "name": "@hymem/cli",
  "type": "module",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "CLI and MCP server for hymem",
  "keywords": [
    "hymem",
    "agent-memory",
    "cli",
    "mcp"
  ],
  "bin": {
    "hymem": "./dist/cli.js",
    "hymem-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "cli": "tsx --no-warnings src/cli.ts",
    "schema": "tsx --no-warnings src/cli.ts schema",
    "mcp": "tsx --no-warnings src/mcp-server.ts",
    "bootstrap": "tsx --no-warnings src/bootstrap.ts",
    "eval": "tsx --no-warnings src/eval.ts",
    "conformance": "tsx --no-warnings src/run-conformance.ts",
    "sql-checks": "tsx --no-warnings src/run-sql-checks.ts",
    "tenancy-checks": "tsx --no-warnings src/run-tenancy-checks.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.44",
    "@ai-sdk/openai-compatible": "^3.0.32",
    "@hymem/bolt": "0.4.0",
    "@hymem/postgres": "0.4.0",
    "@hymem/sqlite": "0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.70",
    "commander": "^15.0.0",
    "hymem": "0.4.0",
    "neo4j-driver": "~5.27.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "pg": "^8"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}

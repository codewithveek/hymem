# Tenant boundary. REQUIRED — every fact is scoped to it, and there is no
# default, because an accidentally shared namespace is a data leak.
# One namespace per end user = isolated personal memory.
# One namespace per organisation = shared team memory (then set MEM_SPEAKER
# per person, or everyone collides on the same subject).
MEM_NAMESPACE=local

# Who the human is, when this process serves one person. Use whatever stable id
# your auth system already has; hymem never generates one.
# MEM_SPEAKER=usr_7f3a91

# Placeholder the extractor/planner use for "the human speaking" (default:
# user). Change it only if your domain talks about users literally — otherwise
# "the user clicked export" becomes a fact about the speaker.
# MEM_SPEAKER_TOKEN=__self__

# Which storage adapter the CLI / MCP server / eval use.
# hydradb (default) | neo4j | memgraph | postgres | sqlite | memory
# "memory" needs no services at all — good for trying the CLI first.
MEM_STORE=hydradb

# HydraDB node (defaults match scripts/run-hydra.sh)
HYDRA_BOLT_URL=neo4j://127.0.0.1:7687
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_TOKEN=local-development-token-32-bytes

HYDRADB_REPO="C:\path-to-hydradb-repo-clone"
# LLM via Vercel AI SDK
# LLM_PROVIDER: openai | anthropic | google | openai-compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Only for openai-compatible providers (OpenRouter, Groq, Ollama, LM Studio, vLLM, ...)
# LLM_BASE_URL=http://localhost:11434/v1

# Recall behaviour
# MEM_MAX_FACTS=24
# MEM_ABSTAIN_THRESHOLD=1

# Neo4j / Memgraph basic auth (when MEM_STORE is neo4j or memgraph)
# BOLT_USER=neo4j
# BOLT_PASSWORD=

# SQL stores (MEM_STORE=postgres or sqlite)
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/mydb
# SQLITE_PATH=hymem.db
# How the schema reaches the database: check (default) | auto | off
# MEM_MIGRATE=check
# MEM_TABLE_PREFIX=hymem_

{
  "name": "@hymem/bolt",
  "version": "0.1.1",
  "description": "Graph storage adapter for hymem over Bolt \u2014 HydraDB, Neo4j, Memgraph",
  "keywords": [
    "hymem",
    "agent-memory",
    "hydradb",
    "neo4j",
    "memgraph",
    "bolt",
    "cypher"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codewithveek/hymem.git",
    "directory": "packages/bolt"
  },
  "homepage": "https://github.com/codewithveek/hymem#readme",
  "bugs": {
    "url": "https://github.com/codewithveek/hymem/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hymem/core": "0.1.1"
  },
  "peerDependencies": {
    "neo4j-driver": "~5.27.0"
  }
}

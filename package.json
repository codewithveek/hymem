{
  "name": "hymem",
  "version": "0.2.0",
  "description": "Temporal knowledge-graph agent memory with pluggable stores — CLI, library, and MCP server",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "agent-memory",
    "memory",
    "knowledge-graph",
    "mcp",
    "temporal",
    "adapter",
    "hydradb",
    "neo4j",
    "longmemeval",
    "ai"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stores/memory": {
      "types": "./dist/stores/memory-store.d.ts",
      "import": "./dist/stores/memory-store.js"
    },
    "./stores/cypher": {
      "types": "./dist/stores/cypher/index.d.ts",
      "import": "./dist/stores/cypher/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js"
    },
    "./testing": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js"
    }
  },
  "bin": {
    "hymem": "./dist/cli.js",
    "hymem-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/run-hydra.sh",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "bootstrap": "tsx src/bootstrap.ts",
    "cli": "tsx src/cli.ts",
    "ingest": "tsx src/cli.ts ingest",
    "ask": "tsx src/cli.ts ask",
    "eval": "tsx src/eval.ts",
    "mcp": "tsx src/mcp-server.ts",
    "conformance": "tsx src/testing/run-conformance.ts",
    "inspect": "tsx src/cli.ts inspect"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.44",
    "@ai-sdk/openai-compatible": "^3.0.32",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.70",
    "commander": "^15.0.0",
    "neo4j-driver": "~5.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
